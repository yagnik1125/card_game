{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": ".",
    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "sourceMap": true,

    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },

  "include": [
    "src/**/*",
    "game-engine/src/**/*"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}